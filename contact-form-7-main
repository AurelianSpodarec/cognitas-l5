                </div>
                </div>
                <div class="column is-half">
                <div class="form__group">
                    [text* your-company id:your-company class:form__field  placeholder"Company/Organization"]
                    <label for="your-company " class="form__label">Company/Organization</label>
                </div>
                </div>
            </div>




            <div class="columns">
                <div class="column is-full">
                <div class="form__group">
                    [text* your-country id:your-country class:form__field  placeholder"Country"]
                    <label for="country" class="form__label">Country</label>
                </div>
                </div>
            </div>



            <div class="columns">
            <div class="column">
                <div class="form__group">
                     [textarea* your-message id:your-message class:form__field  placeholder"Your Message"]
                    <label for="message" class="form__label">Your Message</label>
                </div>
            </div>
            </div>


            <div class="form__group-send">

