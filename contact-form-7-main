            <div class="columns">
                <div class="column is-half">
                <div class="form__group">
                    <!-- <input type="name" id="name" class="form__field" placeholder="Name"> -->
                    [text name id:name class:form__field placeholder "Name"]
                    <label for="name" class="form__label">Name</label>
                </div>
                </div>
                <div class="column is-half">
                <div class="form__group">
                    <!-- <input type="email" id="email" class="form__field" placeholder="Email"> -->
                    [email your-email id:your-email class:form__field  placeholder"Email"]
                    <label for="your-email" class="form__label">Email</label>
                </div>
                </div>
            </div>
 

            
            <div class="columns">
                <div class="column is-half">
